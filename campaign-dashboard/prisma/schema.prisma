// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(VOLUNTEER)
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts           Account[]
  sessions           Session[]
  campaignMemberships CampaignMember[]
  assignedTasks      Task[]
  eventRSVPs         EventRSVP[]
  taskCheckIns       TaskCheckIn[]

  @@map("users")
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  primaryColor String? @default("#3B82F6")
  secondaryColor String? @default("#1F2937")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members        CampaignMember[]
  volunteers     Volunteer[]
  events         Event[]
  tasks          Task[]
  taskCategories TaskCategory[]
  eventTypes     EventType[]
  subscriptions  Subscription[]

  @@map("campaigns")
}

model CampaignMember {
  id         String       @id @default(cuid())
  userId     String
  campaignId String
  role       CampaignRole @default(VOLUNTEER)
  joinedAt   DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([userId, campaignId])
  @@map("campaign_members")
}

model Volunteer {
  id           String   @id @default(cuid())
  campaignId   String
  name         String
  email        String
  phone        String?
  address      String?
  skills       String // JSON string of skills array
  availability String // JSON string of availability array
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tasks        Task[]
  eventRSVPs   EventRSVP[]
  taskCheckIns TaskCheckIn[]

  @@map("volunteers")
}

model Event {
  id          String    @id @default(cuid())
  campaignId  String
  eventTypeId String?
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  maxAttendees Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  campaign  Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  eventType EventType?  @relation(fields: [eventTypeId], references: [id])
  rsvps     EventRSVP[]

  @@map("events")
}

model EventType {
  id         String @id @default(cuid())
  campaignId String
  name       String
  color      String @default("#3B82F6")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events   Event[]

  @@map("event_types")
}

model EventRSVP {
  id          String     @id @default(cuid())
  eventId     String
  volunteerId String?
  userId      String?
  status      RSVPStatus @default(PENDING)
  attendedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer Volunteer? @relation(fields: [volunteerId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@unique([eventId, volunteerId])
  @@unique([eventId, userId])
  @@map("event_rsvps")
}

model Task {
  id             String     @id @default(cuid())
  campaignId     String
  categoryId     String?
  assignedToId   String?
  volunteerId    String?
  title          String
  description    String?
  priority       Priority   @default(MEDIUM)
  status         TaskStatus @default(PENDING)
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?
  location       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category    TaskCategory?  @relation(fields: [categoryId], references: [id])
  assignedTo  User?          @relation(fields: [assignedToId], references: [id])
  volunteer   Volunteer?     @relation(fields: [volunteerId], references: [id])
  checkIns    TaskCheckIn[]

  @@map("tasks")
}

model TaskCategory {
  id         String @id @default(cuid())
  campaignId String
  name       String
  color      String @default("#3B82F6")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@map("task_categories")
}

model TaskCheckIn {
  id          String    @id @default(cuid())
  taskId      String
  volunteerId String?
  userId      String?
  checkInAt   DateTime  @default(now())
  checkOutAt  DateTime?
  notes       String?
  location    String?

  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  volunteer Volunteer? @relation(fields: [volunteerId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])

  @@map("task_check_ins")
}

model Subscription {
  id              String           @id @default(cuid())
  campaignId      String
  plan            SubscriptionPlan @default(BASE)
  status          SubscriptionStatus @default(ACTIVE)
  stripeCustomerId String?
  stripeSubscriptionId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([stripeCustomerId])
  @@unique([stripeSubscriptionId])
  @@map("subscriptions")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  recipient String // email or phone number
  subject   String?
  message   String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("notifications")
}

// Enums
enum UserRole {
  ADMIN
  CAMPAIGN_MANAGER
  VOLUNTEER
}

enum CampaignRole {
  ADMIN
  MANAGER
  VOLUNTEER
}

enum RSVPStatus {
  PENDING
  CONFIRMED
  DECLINED
  ATTENDED
  NO_SHOW
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubscriptionPlan {
  BASE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  UNPAID
}

enum NotificationType {
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}